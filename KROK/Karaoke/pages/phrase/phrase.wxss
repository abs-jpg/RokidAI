:root {
  --phrase-green: #4cc773;
  --phrase-muted: #339254;
  --phrase-border: #224c31;
}
.phrase-screen {
  position: relative;
  width: 448px;
  height: 328px;
  margin: 12px 16px;
  overflow: hidden;
  color: var(--phrase-green);
}
.phrase-content, .phrase-canvas, .phrase-loading {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.phrase-loading {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.phrase-canvas { z-index: 4; pointer-events: none; }
.phrase-heading, .phrase-picker-heading {
  position: absolute;
  top: 3%;
  left: 23%;
  right: 23%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.phrase-song, .phrase-picker-title {
  font-size: 17px;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}
.phrase-muted { font-size: 11px; color: var(--phrase-muted); }
.phrase-target {
  position: absolute;
  top: 18%;
  left: 4%;
  right: 4%;
  height: 14%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
}
.phrase-lyric { font-size: 21px; line-height: 22px; font-weight: bold; }
.phrase-track {
  position: absolute;
  top: 34%;
  left: 3%;
  right: 3%;
  height: 27%;
  box-sizing: border-box;
  border: 1px solid var(--phrase-border);
  border-radius: 5px;
  background-color: rgba(76,199,115,0.04);
}
.phrase-stage {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 2px 7px;
  color: var(--phrase-muted);
  font-size: 10px;
}
.phrase-countdown {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--phrase-green);
  font-size: 19px;
  letter-spacing: 5px;
}
.phrase-readout {
  position: absolute;
  top: 62%;
  left: 3%;
  right: 3%;
  color: var(--phrase-muted);
  font-size: 12px;
}
.phrase-metrics, .phrase-metric, .phrase-asr {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.phrase-metrics { justify-content: space-between; padding: 0 4px; }
.phrase-metric { gap: 6px; }
.phrase-value { font-size: 19px; font-weight: bold; color: var(--phrase-green); margin-left: 5px; }
.phrase-pitch-detail { font-size: 11px; }
.phrase-asr { margin-top: 3px; padding: 0 4px; }
.phrase-asr-label { margin-right: 7px; flex-shrink: 0; }
.phrase-heard {
  color: var(--phrase-green);
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
  min-width: 0;
}
.phrase-button {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid #357f52;
  background-color: transparent;
  border-radius: 5px;
  box-sizing: border-box;
  color: var(--phrase-green);
  font-size: 15px;
  font-weight: bold;
}
.phrase-utility { font-size: 12px; }
.phrase-primary { border-color: #449e63; }
.phrase-active { border-color: #65e08a; }
.phrase-disabled { border-color: #2a653f; color: var(--phrase-muted); }
.phrase-row {
  flex-direction: row;
  justify-content: flex-start;
  padding: 0 10px;
  font-size: 14px;
  font-weight: normal;
}
.phrase-current { border-color: #388d55; }
.phrase-time { color: var(--phrase-muted); margin-right: 12px; flex-shrink: 0; }
.phrase-row-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.phrase-footer {
  position: absolute;
  bottom: 2%;
  left: 0;
  width: 100%;
  text-align: center;
  color: var(--phrase-muted);
  font-size: 11px;
}
.phrase-compact .phrase-song, .phrase-compact .phrase-picker-title { font-size: 13px; }
.phrase-compact .phrase-lyric { font-size: 14px; line-height: 14px; }
.phrase-compact .phrase-countdown { font-size: 13px; letter-spacing: 3px; }
.phrase-compact .phrase-button, .phrase-compact .phrase-value { font-size: 12px; }
.phrase-compact .phrase-muted, .phrase-compact .phrase-readout,
.phrase-compact .phrase-pitch-detail, .phrase-compact .phrase-footer { font-size: 9px; }
