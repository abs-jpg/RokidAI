    {
      "id": "red-high-heels",
      "name": "红色高跟鞋",
      "artist": "蔡健雅",
      "album": "红色高跟鞋",
      "category": "中文",
      "tag": "练习",
      "difficulty": 2,
      "durationMs": 206590,
      "chartVersion": 1,
      "scoringVersion": 2,
      "audioSource": "/source/red-high-heels.ogg",
      "instrumentalSource": "/source/red-high-heels-instrumental.ogg",
      "lyrics": [
        {
          "text": "該怎麼去形容你最貼切",
          "startMs": 22260,
          "endMs": 27470
        },
        {
          "text": "拿什麼跟你作比較才算特別",
          "startMs": 27470,
          "endMs": 33050
        },
        {
          "text": "對你的感覺 強烈",
          "startMs": 33050,
          "endMs": 35960
        },
        {
          "text": "卻又不太瞭解 只憑直覺",
          "startMs": 35960,
          "endMs": 42000
        },
        {
          "text": "你像窩在被子裡的舒服",
          "startMs": 42000,
          "endMs": 47370
        },
        {
          "text": "卻又像風 琢磨不住",
          "startMs": 47370,
          "endMs": 52630
        },
        {
          "text": "像手腕上散發的香水味",
          "startMs": 52630,
          "endMs": 58200
        },
        {
          "text": "像愛不釋手的 紅色高跟鞋",
          "startMs": 58200,
          "endMs": 67240
        },
        {
          "text": "",
          "startMs": 67240,
          "endMs": 76970
        },
